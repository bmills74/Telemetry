<Window x:Class="SimCoach.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sim Coach"
        Width="760"
        Height="760"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="Sim Coach" />
            <TextBlock Margin="0,6,0,0" Foreground="Gray" Text="Mock telemetry replay" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,22,0,14">
            <Button Click="LoadCsvClick" Content="Load Garage 61 CSV" />
            <Button Click="LoadReferenceCsvClick" Content="Load Reference Lap" />
            <Button Click="StartClick" Content="Start" />
            <Button Click="PauseClick" Content="Pause" />
            <Button Click="RestartClick" Content="Restart" />
            <Button Click="StopClick" Content="Stop" />
            <CheckBox x:Name="LoopCheckBox" Margin="4,0,12,0" VerticalAlignment="Center" Content="Loop" />
            <CheckBox x:Name="AutoCoachCheckBox" Margin="4,0,12,0" VerticalAlignment="Center" Content="Auto coach" />
            <TextBlock Text="Playback speed:" />
            <ComboBox x:Name="PlaybackSpeedComboBox" Width="90" Margin="8,0,0,0" SelectedIndex="1">
                <ComboBoxItem Content="0.5×" Tag="0.5" />
                <ComboBoxItem Content="1×" Tag="1" />
                <ComboBoxItem Content="2×" Tag="2" />
                <ComboBoxItem Content="5×" Tag="5" />
                <ComboBoxItem Content="20×" Tag="20" />
            </ComboBox>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="FileTextBlock" Foreground="Gray" Text="Replay CSV: none" TextWrapping="Wrap" />
                <TextBlock x:Name="ReferenceFileTextBlock" Margin="0,4,0,0" Foreground="Gray" Text="Reference lap: none" TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0">
                    <Run Text="Key: " />
                    <Run Foreground="#3182CE" Text="solid = mine" />
                    <Run Text=" | " />
                    <Run Foreground="#718096" Text="dashed = reference" />
                </TextBlock>
            </StackPanel>
            <Border Grid.Column="1" Margin="16,0,0,0" Padding="12,8" BorderBrush="#909090" BorderThickness="1" Background="#F7F7F7">
                <StackPanel>
                    <TextBlock Foreground="Gray" Text="Current position" />
                    <TextBlock x:Name="CurrentCornerTextBlock" Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="—" />
                    <TextBlock x:Name="CurrentCornerDetailTextBlock" Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" Foreground="Gray" Text="Time difference" />
                    <TextBlock x:Name="CurrentTimeDifferenceTextBlock" FontSize="18" FontWeight="SemiBold" Text="" />
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock x:Name="StatusTextBlock" Grid.Row="3" Margin="0,10,0,8" FontSize="16" Text="Ready" />

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Expander Header="Speed" IsExpanded="True" Margin="0,0,0,8">
                    <Border Height="150" Margin="8,8,8,8" BorderBrush="#909090" BorderThickness="1" Background="#F7F7F7">
                        <Grid>
                            <Canvas x:Name="SpeedChartCanvas" SizeChanged="ChartCanvasSizeChanged" ClipToBounds="True">
                                <Polyline x:Name="ReferenceSpeedChartLine" Stroke="#718096" StrokeDashArray="4,3" StrokeThickness="2" />
                                <Polyline x:Name="SpeedChartLine" Stroke="#3182CE" StrokeThickness="2" />
                                <Line x:Name="SpeedCursorLine" Stroke="#202020" StrokeDashArray="2,2" StrokeThickness="1" />
                            </Canvas>
                            <TextBlock x:Name="SpeedPanelValue" Margin="8,8,0,0" FontSize="18" FontWeight="SemiBold" Text="—" />
                        </Grid>
                    </Border>
                </Expander>

                <Expander Header="Throttle" IsExpanded="True" Margin="0,0,0,8">
                    <Border Height="150" Margin="8,8,8,8" BorderBrush="#909090" BorderThickness="1" Background="#F7F7F7">
                        <Grid>
                            <Canvas x:Name="ThrottleChartCanvas" SizeChanged="ChartCanvasSizeChanged" ClipToBounds="True">
                                <Polyline x:Name="ReferenceThrottleChartLine" Stroke="#718096" StrokeDashArray="4,3" StrokeThickness="2" />
                                <Polyline x:Name="ThrottleChartLine" Stroke="#2F855A" StrokeThickness="2" />
                                <Line x:Name="ThrottleCursorLine" Stroke="#202020" StrokeDashArray="2,2" StrokeThickness="1" />
                            </Canvas>
                            <TextBlock x:Name="ThrottlePanelValue" Margin="8,8,0,0" FontSize="18" FontWeight="SemiBold" Text="—" />
                        </Grid>
                    </Border>
                </Expander>

                <Expander Header="Brake" IsExpanded="False" Margin="0,0,0,8">
                    <Border Height="150" Margin="8,8,8,8" BorderBrush="#909090" BorderThickness="1" Background="#F7F7F7">
                        <Grid>
                            <Canvas x:Name="BrakeChartCanvas" SizeChanged="ChartCanvasSizeChanged" ClipToBounds="True">
                                <Polyline x:Name="ReferenceBrakeChartLine" Stroke="#718096" StrokeDashArray="4,3" StrokeThickness="2" />
                                <Polyline x:Name="BrakeChartLine" Stroke="#E53E3E" StrokeThickness="2" />
                                <Line x:Name="BrakeCursorLine" Stroke="#202020" StrokeDashArray="2,2" StrokeThickness="1" />
                            </Canvas>
                            <TextBlock x:Name="BrakePanelValue" Margin="8,8,0,0" FontSize="18" FontWeight="SemiBold" Text="—" />
                        </Grid>
                    </Border>
                </Expander>

                <Expander Header="Steering" IsExpanded="False" Margin="0,0,0,8">
                    <Border Height="150" Margin="8,8,8,8" BorderBrush="#909090" BorderThickness="1" Background="#F7F7F7">
                        <Grid>
                            <Canvas x:Name="SteeringChartCanvas" SizeChanged="ChartCanvasSizeChanged" ClipToBounds="True">
                                <Polyline x:Name="ReferenceSteeringChartLine" Stroke="#718096" StrokeDashArray="4,3" StrokeThickness="2" />
                                <Polyline x:Name="SteeringChartLine" Stroke="#805AD5" StrokeThickness="2" />
                                <Line x:Name="SteeringCursorLine" Stroke="#202020" StrokeDashArray="2,2" StrokeThickness="1" />
                            </Canvas>
                            <TextBlock x:Name="SteeringPanelValue" Margin="8,8,0,0" FontSize="18" FontWeight="SemiBold" Text="—" />
                        </Grid>
                    </Border>
                </Expander>

                <Expander Header="Line" IsExpanded="False" Margin="0,0,0,8">
                    <Border Height="150" Margin="8,8,8,8" BorderBrush="#909090" BorderThickness="1" Background="#F7F7F7">
                        <Grid>
                            <Canvas x:Name="LineChartCanvas" SizeChanged="ChartCanvasSizeChanged" ClipToBounds="True">
                                <Polyline x:Name="ReferenceLineChartLine" Stroke="#718096" StrokeDashArray="4,3" StrokeThickness="2" />
                                <Polyline x:Name="LineChartLine" Stroke="#DD6B20" StrokeThickness="2" />
                                <Line x:Name="LineCursorLine" Stroke="#202020" StrokeDashArray="2,2" StrokeThickness="1" />
                            </Canvas>
                            <TextBlock x:Name="LinePanelValue" Margin="8,8,0,0" FontSize="18" FontWeight="SemiBold" Text="—" />
                        </Grid>
                    </Border>
                </Expander>

                <Expander x:Name="CornerAnalysisExpander" Header="Corner analysis" IsExpanded="False" Margin="0,0,0,8">
                    <TextBlock x:Name="CornerAnalysisTextBlock" Margin="8,8,8,14" Text="Load replay and reference laps to analyse corners." TextWrapping="Wrap" />
                </Expander>

                <Expander Header="Coach" IsExpanded="True" Margin="0,0,0,8">
                    <Grid Margin="8,8,8,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="ListenButton" Content="🎙 Record" Click="ListenButtonClick" />
                                <Button Click="SpeakCoachClick" Content="Speak" />
                                <Button Click="AskCoachClick" Content="Ask" />
                            </StackPanel>
                            <TextBox x:Name="CoachInputTextBox" Margin="0,0,8,0" VerticalContentAlignment="Center" KeyDown="CoachInputKeyDown" />
                        </DockPanel>
                        <DockPanel Grid.Row="1" Margin="0,8,0,0">
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="Gray" Text="Voice" />
                            <ComboBox x:Name="VoiceComboBox" Width="210" SelectionChanged="VoiceComboBoxSelectionChanged" />
                            <TextBlock Margin="16,0,8,0" VerticalAlignment="Center" Foreground="Gray" Text="Rate" />
                            <Slider x:Name="SpeechRateSlider" Width="120" Minimum="-4" Maximum="2" ValueChanged="SpeechRateSliderValueChanged" />
                            <Button Click="StopSpeakingClick" Content="Stop speaking" />
                        </DockPanel>
                        <TextBlock x:Name="CoachResponseTextBlock" Grid.Row="2" Margin="0,10,0,0" Text="Try: Which corner should I focus on?" TextWrapping="Wrap" />
                    </Grid>
                </Expander>

                <Expander Header="Time difference" IsExpanded="False" Margin="0,0,0,8">
                    <StackPanel Margin="8,8,8,14">
                        <TextBlock x:Name="TimeDifferencePanelValue" FontSize="18" FontWeight="SemiBold" Text="—" />
                        <TextBlock Margin="0,6,0,0" Foreground="Gray" Text="Reference-lap comparison will appear here once the comparison engine is added." TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="5" Margin="0,12,0,0">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="Timeline" />
                <Slider x:Name="TimelineSlider" Grid.Column="1" IsEnabled="False" Minimum="0" Maximum="1" HorizontalAlignment="Stretch" ValueChanged="TimelineSliderValueChanged" />
                <TextBlock x:Name="TimelineValueTextBlock" Grid.Column="2" Margin="10,0,0,0" Width="90" VerticalAlignment="Center" Text="0 / 0" />
            </Grid>
            <TextBlock x:Name="LapTextBlock" Foreground="Gray" Text="Lap —" />
            <TextBlock x:Name="FooterTextBlock" Foreground="Gray" Text="Load a CSV to begin." />
        </StackPanel>
    </Grid>
</Window>
